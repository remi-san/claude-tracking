    {
      "id": 29,
      "type": "timeseries",
      "title": "Context size by session (main thread)",
      "description": "Tokens sent to the model per main-thread request: input + cache read + cache write. Subagents have their own context and are excluded. Drops after /compact or /clear.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (session_id) (max_over_time({service_name=~\"claude-code|claude-code-desktop\"} | event_name=~\"(claude_code\\\\.)?api_request\" | query_source=~\"repl_main_thread|sdk\" | model=~\"$model\" | label_format context_tokens=`{{ if .input_tokens }}{{ add .input_tokens .cache_read_tokens .cache_creation_tokens }}{{ end }}` | unwrap context_tokens [$__auto]))",
          "legendFormat": "{{session_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 3,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
